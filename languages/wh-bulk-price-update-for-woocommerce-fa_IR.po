#. Plugin Name of the plugin
#: wh-bulk-price-update.php
msgid "Bulk Price Update for WooCommerce"
msgstr "بروزرسانی گروهی قیمت برای ووکامرس"

#. Plugin URI of the plugin
#: wh-bulk-price-update.php
msgid "https://github.com/webhead-GmbH/wh-bulk-price-update-for-woocommerce"
msgstr "https://github.com/webhead-GmbH/wh-bulk-price-update-for-woocommerce"

#. Description of the plugin
#: wh-bulk-price-update.php
msgid ""
"Easily update WooCommerce product prices in bulk by percentage or fixed "
"amounts based on categories, tags, and attributes."
msgstr ""
"قیمت محصولات ووکامرس را به‌صورت گروهی، بر اساس درصد یا مبلغ ثابت و با توجه "
"به دسته‌بندی‌ها، برچسب‌ها و ویژگی‌ها به‌سادگی به‌روزرسانی کنید."

#. Author of the plugin
#: wh-bulk-price-update.php
msgid "webhead GmbH"
msgstr "webhead GmbH"

#. Author URI of the plugin
#: wh-bulk-price-update.php
msgid "https://webhead.at"
msgstr "https://webhead.at"

